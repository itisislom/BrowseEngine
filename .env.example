# Option 1: OpenRouter (Recommended: 100% Free Qwen 2.5 Coder & DeepSeek R1, zero credit card)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# Available free models:
# MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# MODEL=deepseek/deepseek-r1:free
# MODEL=deepseek/deepseek-chat:free

# Option 2: Groq (Ultra-fast, generous free tier with 14,400 req/day)
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_key_here
# MODEL=qwen-2.5-coder-32b
# MODEL=deepseek-r1-distill-llama-70b

# Option 3: Hugging Face (Requires pre-paid credits or PRO subscription)
# HF_TOKEN=hf_your_token_here
# HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Option 4: WonkaChat (Optional)
# WONKA_API_KEY=your_wonkachat_api_key_here
# WONKA_BASE_URL=https://<your-organization>.wonka.chat/api/agents/v1
# WONKA_MODEL=agent_your_agent_id_here


