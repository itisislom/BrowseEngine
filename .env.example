# Hugging Face Serverless API (Recommended, Free)
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_BASE_URL=https://router.huggingface.co/hf-inference/v1
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# Alternative Hugging Face model:
# HF_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B

# WonkaChat / OpenAI-compatible API Configuration (Optional)
WONKA_API_KEY=your_wonkachat_api_key_here
WONKA_BASE_URL=https://<your-organization>.wonka.chat/api/agents/v1
WONKA_MODEL=agent_your_agent_id_here

